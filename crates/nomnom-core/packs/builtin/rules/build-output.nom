# Directories a toolchain rebuilds from source.
#
# The dangerous half of this file is the generic names. `target`, `build`, `bin`
# and `obj` are also ordinary words: someone's shooting-range dataset lives in
# `target/`, and deleting it because of a name would be the worst thing this
# tool could do. Those names therefore need a sibling file proving a toolchain
# owns the directory, and without it the verdict drops to `review`.
#
# Every target is one decision for its whole subtree, so nothing inside a
# `node_modules` is judged again on its own.

# -- unambiguous names -----------------------------------------------------
#
# These mean the same thing everywhere they appear, so a name is enough.

[node_modules/]
description = regenerable: npm dependency tree, rebuilt by `npm install`
kind = build-output/v1
confidence = 0.95
filter {
  then $p/node_modules/
}

[.venv/]
description = regenerable: Python virtualenv, rebuilt by `python -m venv` plus a reinstall
kind = build-output/v1
confidence = 0.95
filter {
  then $p/.venv/
}

[venv/]
description = regenerable: Python virtualenv, rebuilt by `python -m venv` plus a reinstall
kind = build-output/v1
confidence = 0.95
filter {
  then $p/venv/
}

[__pycache__/]
description = regenerable: Python bytecode cache, rewritten on the next import
kind = build-output/v1
confidence = 0.95
filter {
  then $p/__pycache__/
}

[.next/]
description = regenerable: Next.js build output, rebuilt by `next build`
kind = build-output/v1
confidence = 0.95
filter {
  then $p/.next/
}

[.gradle/]
description = regenerable: Gradle project cache, rebuilt on the next Gradle run
kind = build-output/v1
confidence = 0.95
filter {
  then $p/.gradle/
}

[.tox/]
description = regenerable: tox environments, rebuilt by `tox`
kind = build-output/v1
confidence = 0.95
filter {
  then $p/.tox/
}

[.mypy_cache/]
description = regenerable: mypy incremental cache, rebuilt on the next type-check
kind = build-output/v1
confidence = 0.95
filter {
  then $p/.mypy_cache/
}

[.pytest_cache/]
description = regenerable: pytest run cache, rewritten on the next test run
kind = build-output/v1
confidence = 0.95
filter {
  then $p/.pytest_cache/
}

# -- generic names, corroborated -------------------------------------------
#
# The alternatives are tried in written order, and the description names the
# file that actually sits beside the directory.

[Cargo target/]
description = regenerable: Cargo build output, rebuilt by `cargo build` — `{$marker}` sits beside it
kind = build-output/v1
filter {
  $dir has Cargo.toml as $marker
  then $dir/target/
}

[build/ beside a manifest]
description = regenerable: build output, rebuilt by the project's build command — `{$marker}` sits beside it
kind = build-output/v1
filter {
  $dir has package.json | pyproject.toml | CMakeLists.txt as $marker
  then $dir/build/
}

[dist/ beside a manifest]
description = regenerable: build output, rebuilt by the project's build command — `{$marker}` sits beside it
kind = build-output/v1
filter {
  $dir has package.json | pyproject.toml | CMakeLists.txt as $marker
  then $dir/dist/
}

[.NET bin/]
description = regenerable: .NET build output, rebuilt by `dotnet build` — `{$marker}` sits beside it
kind = build-output/v1
filter {
  $dir has *.csproj | *.sln as $marker
  then $dir/bin/
}

[.NET obj/]
description = regenerable: .NET build output, rebuilt by `dotnet build` — `{$marker}` sits beside it
kind = build-output/v1
filter {
  $dir has *.csproj | *.sln as $marker
  then $dir/obj/
}

# -- generic names, uncorroborated -----------------------------------------
#
# The name matched and nothing backs it up. Still shown, because the human
# wants to see it, but `review` and low confidence: this is as likely to be
# their data as it is to be build output.

[target/ without Cargo.toml]
description = named `target`, but no Cargo.toml beside it — `target` is also an ordinary directory name, so this may be your data rather than build output
kind = build-output/v1
disposition = review
confidence = 0.35
filter {
  $dir lacks Cargo.toml
  then $dir/target/
}

[build/ without a manifest]
description = named `build`, but no package.json or pyproject.toml or CMakeLists.txt beside it — `build` is also an ordinary directory name, so this may be your data rather than build output
kind = build-output/v1
disposition = review
confidence = 0.35
filter {
  $dir lacks package.json | pyproject.toml | CMakeLists.txt
  then $dir/build/
}

[dist/ without a manifest]
description = named `dist`, but no package.json or pyproject.toml or CMakeLists.txt beside it — `dist` is also an ordinary directory name, so this may be your data rather than build output
kind = build-output/v1
disposition = review
confidence = 0.35
filter {
  $dir lacks package.json | pyproject.toml | CMakeLists.txt
  then $dir/dist/
}

[bin/ without a .NET project]
description = named `bin`, but no *.csproj or *.sln beside it — `bin` is also an ordinary directory name, so this may be your data rather than build output
kind = build-output/v1
disposition = review
confidence = 0.35
filter {
  $dir lacks *.csproj | *.sln
  then $dir/bin/
}

[obj/ without a .NET project]
description = named `obj`, but no *.csproj or *.sln beside it — `obj` is also an ordinary directory name, so this may be your data rather than build output
kind = build-output/v1
disposition = review
confidence = 0.35
filter {
  $dir lacks *.csproj | *.sln
  then $dir/obj/
}
