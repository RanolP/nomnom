# Cache directories: refillable, but not free to lose.
#
# `cache/v1` carries a lower confidence than build output, because "cache" is a
# word an application also uses for state it cannot rebuild. A target is one
# decision for its subtree, so a nested `cache/cache` is never counted twice.
#
# One rule per name rather than one rule matching all three: the description
# quotes the directory name back as a literal, which makes the quoted name the
# canonical spelling — a `CACHE` on NTFS still reads as `cache` in the
# sentence.

[.cache/]
description = cache directory `.cache`: {subtree_size} bytes across {file_count} files, refilled on next use
kind = cache/v1
filter {
  then $p/.cache/
}

[cache/]
description = cache directory `cache`: {subtree_size} bytes across {file_count} files, refilled on next use
kind = cache/v1
filter {
  then $p/cache/
}

[caches/]
description = cache directory `caches`: {subtree_size} bytes across {file_count} files, refilled on next use
kind = cache/v1
filter {
  then $p/caches/
}
