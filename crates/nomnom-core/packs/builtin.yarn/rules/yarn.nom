# Yarn's installed tree.

# Yarn 1 writes `node_modules/.yarn-integrity`; Yarn 2 and later, with the
# `node-modules` linker, write `node_modules/.yarn-state.yml`. pnpm's
# markers beside one of them mean pnpm installed over Yarn, and pnpm then
# owns the layout.
[Yarn node_modules/]
description = regenerable: Yarn dependency tree, rebuilt by `yarn install` — it holds Yarn's `{$marker}`
kind = build-output/v1
filter {
  $n.dir.name == "node_modules"
  $n has .yarn-integrity | .yarn-state.yml as $marker
  $n lacks .modules.yaml | .pnpm | .pnpm-workspace-state-v1.json
  then $n/
}

# Yarn 1 kept its cache in a versioned directory under `Yarn/Cache`
# (`~/.cache/yarn` elsewhere), named for Yarn's internal `CACHE_VERSION`
# (currently `v6`: https://github.com/yarnpkg/yarn/blob/master/src/constants.js).
# Classic Yarn's own docs (https://classic.yarnpkg.com/en/docs/cli/cache/,
# https://classic.yarnpkg.com/en/docs/install/) never state this path or the
# version number — only `yarn cache dir`/`yarn config get cacheFolder`
# resolve it reliably — and each package subfolder beneath it is named
# `npm-<name>-<version>-<hash>`, so there is no fixed child name a `has`
# filter could pin as a signature either. Dropped rather than kept on name
# alone or given an unreliable signature.
