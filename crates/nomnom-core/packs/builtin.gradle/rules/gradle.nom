# Gradle's project cache directory and the caches under `GRADLE_USER_HOME`.

# Every project build writes `.gradle/buildOutputCleanup/` in the root project.
[Gradle project .gradle/]
description = regenerable: Gradle project cache, rebuilt on the next Gradle run — it holds Gradle's `buildOutputCleanup`
kind = build-output/v1
confidence = 0.95
filter {
  $g.dir.name == ".gradle"
  $g has buildOutputCleanup
  then $g/
}

# `~/.gradle/caches`, whose dependency cache is `modules-2`.
[Gradle dependency caches]
description = Gradle's dependency and transform caches; Gradle re-downloads and recomputes on the next build
kind = cache/v1
confidence = 0.8
filter {
  $c.dir.name == "caches"
  $c under .gradle/
  $c has modules-2
  then $c/
}

# Gradle distributions the wrapper downloaded. A build re-downloads its own
# version, but these are toolchains, so review only.
[Gradle wrapper distributions]
description = Gradle distributions downloaded by the Gradle wrapper; the wrapper downloads its version again on the next build
kind = cache/v1
disposition = review
confidence = 0.7
filter {
  $w.dir.name == "wrapper"
  $w under .gradle/
  then $w/dists/
}
