# pip's cache: `%LocalAppData%\pip\cache` on Windows, `~/.cache/pip`
# elsewhere. It holds HTTP responses in `http-v2` (`http` before pip 23.3) and
# locally built wheels in `wheels`.

[pip cache]
description = pip's download and wheel cache; pip downloads or rebuilds on the next install
kind = cache/v1
confidence = 0.8
filter {
  $c.dir.name == "cache"
  $c under pip/
  $c has http-v2 | http
  $c has wheels
  then $c/
}

[pip cache (XDG layout)]
description = pip's download and wheel cache; pip downloads or rebuilds on the next install
kind = cache/v1
confidence = 0.8
filter {
  $c.dir.name == "pip"
  $c has http-v2 | http
  $c has wheels
  then $c/
}
