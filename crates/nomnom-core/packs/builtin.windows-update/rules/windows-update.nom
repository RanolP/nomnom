# Windows Update's download cache, `C:\Windows\SoftwareDistribution\Download`,
# beside its `DataStore`. Windows Update downloads again what it still needs,
# but an update mid-install depends on it, so review only.
[Windows Update downloads]
description = Windows Update's download cache; Windows Update downloads again what it still needs (stop the Windows Update service first)
kind = cache/v1
disposition = review
confidence = 0.6
filter {
  $s.dir.name == "SoftwareDistribution"
  $s has DataStore
  then $s/Download/
}
