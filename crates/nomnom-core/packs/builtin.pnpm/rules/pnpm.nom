# pnpm's installed tree, its content-addressable store, and its metadata cache.

# pnpm writes `node_modules/.modules.yaml` into every tree it installs, keeps
# its virtual store in `node_modules/.pnpm`, and pnpm 10 adds
# `.pnpm-workspace-state-v1.json`. Any one of them is pnpm's: an interrupted
# or copied install can lack `.modules.yaml` and still hold the other two.
[pnpm node_modules/]
description = regenerable: pnpm dependency tree, rebuilt by `pnpm install` — it holds pnpm's `{$marker}`
kind = build-output/v1
confidence = 0.95
filter {
  $n.dir.name == "node_modules"
  $n has .modules.yaml | .pnpm | .pnpm-workspace-state-v1.json as $marker
  then $n/
}

# Every pnpm project's `node_modules` hard-links into the store. A project
# keeps working without it, but the next install re-downloads everything, and
# a package no longer on the registry is gone for good, so the store is shown
# for review only. Store layouts are versioned (`v3`, `v10`, `v11`).
[pnpm store]
description = pnpm's content-addressable package store; the next `pnpm install` re-downloads what is missing, but a package unpublished from the registry cannot be fetched again
kind = cache/v1
disposition = review
confidence = 0.7
filter {
  $s.dir.name == "store"
  $s under pnpm/
  $s has v3 | v10 | v11
  then $s/
}

[pnpm project-local store]
description = a pnpm package store kept beside a project; the next `pnpm install` re-downloads what is missing, but a package unpublished from the registry cannot be fetched again
kind = cache/v1
disposition = review
confidence = 0.7
filter {
  $s.dir.name == ".pnpm-store"
  $s has v3 | v10 | v11
  then $s/
}

[pnpm metadata cache]
description = pnpm's registry metadata cache; pnpm fetches the metadata again on the next install
kind = cache/v1
confidence = 0.8
filter {
  $c.dir.name == "pnpm-cache"
  $c has metadata | metadata-v1.3
  then $c/
}
