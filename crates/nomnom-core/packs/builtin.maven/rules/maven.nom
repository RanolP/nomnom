# Maven's local repository, `~/.m2/repository`. A build re-downloads what it
# needs, but artifacts installed locally (`mvn install`) or from a repository
# you no longer reach exist nowhere else, so review only.
[Maven local repository]
description = Maven's local repository; Maven re-downloads what a build needs, but locally installed artifacts exist nowhere else
kind = cache/v1
disposition = review
confidence = 0.6
filter {
  $m.dir.name == ".m2"
  then $m/repository/
}
